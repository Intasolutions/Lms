# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=

# Database (Default uses SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/lms_db

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AWS S3 & SES (Optional for local development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_SES_REGION_NAME=ap-south-1
DEFAULT_FROM_EMAIL=no-reply@example.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Authentication
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MOBILE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# External Integrations (Optional)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
SENTRY_DSN=

# App Store Review Mock Credentials (for testing / review bypass)
APP_REVIEW_ENABLED=True
APP_REVIEW_PHONE_NUMBER=+919999900001
APP_REVIEW_STATIC_OTP=839201

# Academy Billing & Organization Metadata
ACADEMY_NAME=LMS Academy
ACADEMY_LEGAL_NAME=LMS Academy Pvt Ltd
ACADEMY_ADDRESS=123 Learning Way, Suite 100
ACADEMY_GSTIN=
ACADEMY_PAN=
ACADEMY_BILLING_EMAIL=support@example.com
ACADEMY_BILLING_PHONE=+1234567890
ACADEMY_WEBSITE=http://localhost:3000
